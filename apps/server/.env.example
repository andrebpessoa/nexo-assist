# Copied to apps/server/.env by `bun run setup`. Rules and types live in .env.schema.

NODE_ENV=development

# At least 32 characters. `bun run setup` generates one.
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# Simulated ticket service: share of calls that fail on purpose and extra latency.
TICKETS_FAILURE_RATE=0.1
TICKETS_EXTRA_LATENCY_MS=0

# `bun run dev` turns this on for local dev; never true in production.
DEV_SEED_ENABLED=false

# Google AI Studio key (https://aistudio.google.com/apikey). Empty: local dev reads by keywords.
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_MODEL=google/gemini-3.5-flash-lite

# Usage limits: messages per user per minute and model calls per day.
RATE_LIMIT_PER_MINUTE=10
LLM_DAILY_LIMIT=400

# Deploy only: token for POST /admin/seed. Leave empty locally.
SEED_TOKEN=
