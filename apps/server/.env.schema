# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# Share of ticket-service calls that answer SERVICE_UNAVAILABLE on purpose, 0 to 1 (TKT-25, TKT-26)
# @sensitive=false @type=number(min=0, max=1)
TICKETS_FAILURE_RATE=0.1

# Extra latency added to every ticket-service call, in milliseconds (TKT-25)
# @sensitive=false @type=number(min=0, isInt=true)
TICKETS_EXTRA_LATENCY_MS=0

# Local dev only: enables POST /internal/seed and the /internal/tickets test routes. Never in production.
# @sensitive=false @type=boolean
DEV_SEED_ENABLED=false

# Gemini key for the agent's understanding (Mastra). Without it, local dev with DEV_SEED_ENABLED=true reads by keywords and other envs answer "model unavailable".
# @optional @sensitive
GOOGLE_GENERATIVE_AI_API_KEY=

# Model for the agent, as provider/model for the Mastra model router (AD-008). Default: Gemini Flash-Lite.
# @sensitive=false @optional
LLM_MODEL=google/gemini-3.5-flash-lite

# Messages each user may send per minute; the next one gets "Limite de uso atingido. Tente mais tarde." (DLV-13)
# @sensitive=false @type=number(min=1, isInt=true)
RATE_LIMIT_PER_MINUTE=10

# Model calls allowed per UTC day across all users; past it every message gets the same answer (DLV-13)
# @sensitive=false @type=number(min=1, isInt=true)
LLM_DAILY_LIMIT=400

# Deploy only: enables POST /admin/seed, which needs it as a Bearer token. Empty: the route is 404.
# @optional @sensitive
SEED_TOKEN=
