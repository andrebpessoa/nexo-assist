{
	"name": "nexo-assist",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"varlock": "1.23.0",
			"@cloudflare/workers-types": "^5.20260906.1",
			"@trpc/server": "^11.19.0",
			"better-auth": "1.7.12",
			"next-themes": "^0.4.6",
			"sonner": "^2.0.8",
			"@trpc/client": "^11.19.0",
			"tailwindcss": "^4.3.3",
			"drizzle-orm": "1.0.0-rc.5"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"dev:stack": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"dev:web": "turbo run dev:bare -F web --",
		"dev:server": "turbo run dev:bare -F hono --",
		"db:generate": "turbo run db:generate -F @nexo-assist/db --",
		"db:seed": "bun scripts/db-seed.ts",
		"setup": "bun scripts/setup.ts",
		"eval": "bun run --cwd packages/agent eval",
		"deploy": "turbo run deploy -F @nexo-assist/infra --",
		"destroy": "turbo run destroy -F @nexo-assist/infra --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"check": "biome check --write ."
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@cloudflare/workers-types": "catalog:",
		"@nexo-assist/config": "workspace:*",
		"@types/node": "^26.4.1",
		"lefthook": "^2.2.1",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "bun@1.4.4"
}
